# CareCart backend environment.
#
# Copy this file to `.env` in the same folder and fill in the values below.
# `.env` is gitignored and must NEVER be committed. This file (.env.example)
# is committed and must NEVER contain a real value.
#
#   cd backend
#   copy .env.example .env      # Windows   (cp on macOS/Linux)


# ─────────────────────────────────────────────────────────────────────────────
# REQUIRED — fill these in. No defaults; the related feature fails without them.
# ─────────────────────────────────────────────────────────────────────────────

# OTP / SMS provider (phone sign-in). e.g. MSG91, Twilio, Firebase Auth.
OTP_PROVIDER_API_KEY=

# Anthropic Claude API key — https://console.anthropic.com/  (starts with "sk-ant-")
CLAUDE_API_KEY=

# openFDA API key — https://open.fda.gov/apis/authentication/
OPENFDA_API_KEY=

# USDA FoodData Central API key — https://fdc.nal.usda.gov/api-key-signup.html
USDA_FDC_API_KEY=


# ─────────────────────────────────────────────────────────────────────────────
# DATABASE — dev credentials, NOT secrets. docker-compose.yml creates the
# postgres database from POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB, and
# the app composes its connection string from the same parts.
# ─────────────────────────────────────────────────────────────────────────────

POSTGRES_USER=carecart
POSTGRES_PASSWORD=carecart
POSTGRES_DB=carecart
POSTGRES_HOST=localhost      # docker-compose overrides this to "postgres"
POSTGRES_PORT=5432

# Optional: set a full SQLAlchemy URL to override the POSTGRES_* parts above
# (e.g. a managed database). Leave blank for local dev.
DATABASE_URL=

# Token-signing secret. A dev placeholder is used if left blank; the app
# REFUSES to start in production (ENVIRONMENT=production) until this is a real
# value.  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=


# ─────────────────────────────────────────────────────────────────────────────
# LOCAL DEV — safe defaults live in app/core/config.py. Override only if needed.
# ─────────────────────────────────────────────────────────────────────────────

# ENVIRONMENT=development
# DEBUG=true
# CORS_ORIGINS=*

# Milvus (infra/docker-compose.yml)
# MILVUS_HOST=localhost        # docker-compose overrides this to "milvus"
# MILVUS_PORT=19530

# Neo4j (Phase 6+)
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=
