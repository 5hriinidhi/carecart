# CareCart backend environment.
#
# Copy this file to `.env` in the same folder and fill in the values below.
# `.env` is gitignored and must NEVER be committed. This file (.env.example)
# is committed and must NEVER contain a real value.
#
#   cd backend
#   copy .env.example .env      # Windows   (cp on macOS/Linux)


# ─────────────────────────────────────────────────────────────────────────────
# REQUIRED — fill these in. No defaults; the related feature fails without them.
# ─────────────────────────────────────────────────────────────────────────────

# OTP / SMS provider (phone sign-in). e.g. MSG91, Twilio, Firebase Auth.
OTP_PROVIDER_API_KEY=

# HTTPS endpoint the backend POSTs to in order to send the SMS. Leave BOTH this
# and OTP_PROVIDER_API_KEY blank for local dev: no SMS is sent, and the code is
# returned in the request-otp response ONLY when ENVIRONMENT is development/test.
# Adapt app/services/otp_sender.py:HttpOtpSender to your provider's payload.
OTP_PROVIDER_URL=

# Sender / from-name shown on the message.
OTP_SENDER_ID=CareCart

# openFDA API key — https://open.fda.gov/apis/authentication/
# Used to refresh drug-label / interaction data; NOT called per scan.
OPENFDA_API_KEY=

# USDA FoodData Central API key — https://fdc.nal.usda.gov/api-key-signup.html
# Used to refresh nutrient data; NOT called per scan.
USDA_FDC_API_KEY=

# Anthropic Claude API key — https://console.anthropic.com/  (starts with "sk-ant-")
# OFFLINE ONLY: the weekly/monthly batch job that tags queued unknown
# ingredients. Runtime scans never call an LLM. Leave blank unless you run
# that job locally.
CLAUDE_API_KEY=


# ─────────────────────────────────────────────────────────────────────────────
# DATABASE — dev credentials, NOT secrets. docker-compose.yml creates the
# postgres database from POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB, and
# the app composes its connection string from the same parts.
# ─────────────────────────────────────────────────────────────────────────────

POSTGRES_USER=carecart
POSTGRES_PASSWORD=carecart
POSTGRES_DB=carecart
# HOST/PORT the app connects to. Inside docker-compose these are forced to
# postgres:5432. They only matter when you run uvicorn on the host against the
# Docker DB - then set PORT to the published host port (default 5433).
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Optional: set a full SQLAlchemy URL to override the POSTGRES_* parts above
# (e.g. a managed database). Leave blank for local dev.
DATABASE_URL=

# Token-signing secret. A dev placeholder is used if left blank; the app
# REFUSES to start in production (ENVIRONMENT=production) until this is a real
# value.  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Health-vault encryption (Fernet). Encrypts the sensitive medication/condition
# columns at the application layer. Dev placeholder used if blank; REQUIRED in
# production.  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
# Previous ENCRYPTION_KEY value(s), comma-separated — decrypt-only, for key
# rotation. New key goes in ENCRYPTION_KEY; move the old one here.
ENCRYPTION_KEYS_OLD=

# Pepper for the HMAC that turns a phone number into users.phone_hash (no
# plaintext phone numbers are stored). Dev placeholder if blank; REQUIRED in
# production.  python -c "import secrets; print(secrets.token_urlsafe(32))"
PHONE_HASH_KEY=


# ─────────────────────────────────────────────────────────────────────────────
# LOCAL DEV — safe defaults live in app/core/config.py. Override only if needed.
# ─────────────────────────────────────────────────────────────────────────────

# ENVIRONMENT=development
# DEBUG=true
# CORS_ORIGINS=*

# Milvus (infra/docker-compose.yml)
# MILVUS_HOST=localhost        # docker-compose overrides this to "milvus"
# MILVUS_PORT=19530

# Neo4j (Phase 6+)
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=
