# Repo-root .env - OPTIONAL. Only for docker-compose host-port overrides.
# Copy to .env at the repo root ONLY if a default port clashes on your machine.
#   cp .env.example .env        (copy .env.example .env on Windows)
#
# App/secret config is NOT here - that lives in backend/.env (see backend/.env.example).
# Both .env files are gitignored.

# Host port for Postgres (container port stays 5432). Default 5433.
# Set to 5432 if you have no local Postgres and prefer the standard port.
POSTGRES_HOST_PORT=5433

# Host port for the backend API. Default 8000.
BACKEND_HOST_PORT=8000

# Vector stack (infra/docker-compose.yml) - only relevant from Phase 3 on.
MILVUS_HOST_PORT=19530
MILVUS_METRICS_PORT=9091
ATTU_HOST_PORT=8100
