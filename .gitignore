# ─── secrets ───────────────────────────────────────────────────────────────
# .env is NEVER committed. .env.example (committed) carries blank values.
.env
.env.*
!.env.example

# ─── python / backend ─────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# ─── flutter / mobile ─────────────────────────────────────────────────────
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.flutter-plugins-list
**/build/
mobile/**/GeneratedPluginRegistrant.*
mobile/ios/Pods/
mobile/ios/.symlinks/
mobile/android/.gradle/
mobile/android/local.properties
mobile/android/key.properties
*.iml

# ─── build artifacts (generic) ────────────────────────────────────────────
dist/
*.log

# ─── IDE / editor ─────────────────────────────────────────────────────────
.idea/
.vscode/
*.code-workspace

# ─── OS ───────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ─── large / regenerable data-prep artifacts ──────────────────────────────
# Raw third-party medicine dataset (18 MB zip, ~354 MB unzipped). Obtain separately.
gradient-ascend-mobile-app/project/dataset/medicine_data.csv.zip
gradient-ascend-mobile-app/project/dataset/medicine_data.csv
# Regenerable outputs of the data_prep scripts
gradient-ascend-mobile-app/project/dataset/data_prep/drug_classes.csv
gradient-ascend-mobile-app/project/dataset/data_prep/food_ingredient_method_log.csv
# Duplicate of packaged_foods_india.csv
gradient-ascend-mobile-app/project/dataset/packaged_foods_india-Ieivcg.csv
# Third-party proposal documents
gradient-ascend-mobile-app/project/uploads/*.pdf
